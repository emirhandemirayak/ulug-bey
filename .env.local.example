# OpenAI-compatible API (OpenAI, OpenRouter, Gemini proxy, etc.)
# For OpenAI: leave OPENAI_BASE_URL as-is and use an OpenAI key + model names.
# For Gemini (Google AI Studio key, https://aistudio.google.com/apikey):
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_CHAT_MODEL=gemini-3.8-flash
#   OPENAI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Text-to-speech (optional). Provider is picked automatically; force one with TTS_PROVIDER=gemini|elevenlabs.
# Gemini TTS reuses OPENAI_API_KEY when OPENAI_BASE_URL points to Google; otherwise set GEMINI_TTS_API_KEY.
# Voice names: https://ai.google.dev/gemini-api/docs/speech-generation (e.g. Charon, Orus, Algenib)
TTS_PROVIDER=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Algenib

# ElevenLabs text-to-speech. Leave empty to skip it.
# Pick a voice at https://elevenlabs.io/app/voice-library (or design one) and copy its Voice ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
